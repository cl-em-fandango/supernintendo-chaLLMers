#!/usr/bin/env bash
#
# harness-run — resource-bounded, auto-restarting container runner for the
# harness (spec FR-2).
#
# Launches the harness-sandbox container with cgroup limits so agent sessions
# cannot starve the host LLM server (the container carries oom_score_adj=+500
# and is therefore the kernel's first kill candidate), then restarts
# `python3 harness.py run --continue` until it exits 0. The harness-side crash
# circuit breaker (FR-5.4) bounds the loop per task, so it cannot spin forever
# on one poisoned task.
#
# Usage: scripts/harness-run [extra args forwarded to `harness.py run --continue`]
#
# Environment overrides:
#   HARNESS_ENGINE         podman|docker (default: first found on PATH)
#   HARNESS_DRY_RUN        1 = print the assembled command and exit 0
#   IMAGE_TAG              image (default harness-sandbox:frozen-latest)
#   WORK_DIR               host dir to run against (default: harnessExecutionAndQueueDir)
#   HARNESS_CONFIG         path to config.json (default <repo root>/config.json)
#   HARNESS_QUEUE_DIR      queue dir mount (default ${WORK_DIR}/queue)
#   PI_AGENT_DIR           host pi agent dir staged writable (default ~/.pi/agent)
#   HARNESS_MEM            --memory          (default 4g)
#   HARNESS_MEM_SWAP       --memory-swap     (default 4g, equals memory => no swap)
#   HARNESS_CPUSET         --cpuset-cpus     (default 8-15)
#   HARNESS_CPU_QUOTA      --cpus            (default 8.0)
#   HARNESS_PIDS_LIMIT     --pids-limit      (default 300)
#   HARNESS_RESTART_SLEEP  seconds between restarts (default 3)
#   HARNESS_SYSFS_DIR      sysfs root for the CPU-count fail-fast check
#
# Note: errexit is deliberately NOT enabled — the restart loop must survive
# non-zero container exits; undefined variables are the failure mode guarded.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

IMAGE_TAG="${IMAGE_TAG:-harness-sandbox:frozen-latest}"
CONFIG_FILE="${HARNESS_CONFIG:-${REPO_ROOT}/config.json}"
MEM_LIMIT="${HARNESS_MEM:-4g}"
MEM_SWAP_LIMIT="${HARNESS_MEM_SWAP:-4g}"
CPUSET="${HARNESS_CPUSET:-8-15}"
CPU_QUOTA="${HARNESS_CPU_QUOTA:-8.0}"
PIDS_LIMIT="${HARNESS_PIDS_LIMIT:-300}"
RESTART_SLEEP="${HARNESS_RESTART_SLEEP:-3}"
OOM_SCORE_ADJ=500
PI_AGENT_DIR="${PI_AGENT_DIR:-${HOME}/.pi/agent}"
PI_AGENT_MOUNT="/home/harnessuser/.pi/agent"
PI_AGENT_STAGE=""

# ---------------------------------------------------------------------------
# Engine detection (FR-2.1): podman first, then docker; HARNESS_ENGINE wins.
# ---------------------------------------------------------------------------
ENGINE_CMD=""
detect_engine() {
    local requested="${HARNESS_ENGINE:-}"
    if [ -n "$requested" ]; then
        if [ "$requested" != "podman" ] && [ "$requested" != "docker" ]; then
            echo "Error: HARNESS_ENGINE must be 'podman' or 'docker', got '${requested}'." >&2
            return 1
        fi
        if ! command -v "$requested" >/dev/null 2>&1; then
            echo "Error: HARNESS_ENGINE=${requested} but '${requested}' is not in PATH." >&2
            return 1
        fi
        ENGINE_CMD="$requested"
        return 0
    fi
    local candidate
    for candidate in podman docker; do
        if command -v "$candidate" >/dev/null 2>&1; then
            ENGINE_CMD="$candidate"
            return 0
        fi
    done
    echo "Error: neither podman nor docker found in PATH." >&2
    echo "       Install one of them, or set HARNESS_ENGINE to an installed engine." >&2
    return 1
}

# ---------------------------------------------------------------------------
# Config directory resolution (FR-2.2): WORK_DIR env wins, else the config's
# harnessExecutionAndQueueDir. The config also names targetCodebaseDir; both are
# absolute paths that are commonly symlinks on the host (/srv/pi-harness ->
# ~/work), and a bind mount of the resolved path does not make the *declared*
# path exist inside the container. So each declared directory is mounted at
# exactly the path the config names, mirroring the host layout the config was
# written against.
# ---------------------------------------------------------------------------
EXEC_DIR=""
TARGET_DIR=""

declare -a MOUNTS=() MNT_SRC=() MNT_DST=()

# add_mount <host_source> <container_target> [force] — idempotent, and skips a
# mount an earlier one already provides (same source subtree at the matching
# relative position under an earlier target). `force` keeps the mount anyway:
# the queue dir is named explicitly on purpose (spec §9 fail-fast, ownership),
# so it is not collapsed into the mount of its parent.
add_mount() {
    local src="$1" dst="$2" force="${3:-}" i rel
    dst="${dst%/}"
    [ -n "$dst" ] || dst="/"
    for i in "${!MNT_DST[@]}"; do
        [ "${MNT_DST[$i]}" = "$dst" ] && return 0
    done
    [ -n "$force" ] || for i in "${!MNT_SRC[@]}"; do
        case "${src}/" in
            "${MNT_SRC[$i]}"/*)
                rel="${src#${MNT_SRC[$i]}/}"
                rel="${rel#/}"
                if [ "${MNT_DST[$i]}/${rel}" = "$dst" ]; then
                    return 0
                fi
                ;;
        esac
    done
    MNT_SRC+=("$src")
    MNT_DST+=("$dst")
    MOUNTS+=("-v" "${src}:${dst}${selinux_suffix}")
}

# mount_declared <declared_path> <label> — skip (never hand to the engine) a
# declared path that does not exist here: the engine would create it root-owned.
mount_declared() {
    local declared="$1" label="$2" src
    [ -n "$declared" ] || return 0
    if [ ! -e "$declared" ] && [ ! -L "$declared" ]; then
        echo "Warning: ${label} '${declared}' does not exist on this host; not mounted." >&2
        return 0
    fi
    src="$(realpath "$declared" 2>/dev/null)" || {
        echo "Warning: ${label} '${declared}' could not be resolved; not mounted." >&2
        return 0
    }
    add_mount "$src" "$declared"
}

read_config_dirs() {
    EXEC_DIR=""
    TARGET_DIR=""
    [ -r "$CONFIG_FILE" ] || return 0
    mapfile -t _cfg_dirs < <(python3 -c '
import json, sys
raw = json.load(open(sys.argv[1]))
print(raw.get("harnessExecutionAndQueueDir") or "")
print(raw.get("targetCodebaseDir") or "")
' "$CONFIG_FILE" 2>/dev/null || true)
    EXEC_DIR="${_cfg_dirs[0]:-}"
    TARGET_DIR="${_cfg_dirs[1]:-}"
}

resolve_work_dir() {
    read_config_dirs
    if [ -z "${WORK_DIR:-}" ]; then
        if [ -z "$EXEC_DIR" ] && [ ! -r "$CONFIG_FILE" ]; then
            echo "Error: cannot read config '${CONFIG_FILE}'." >&2
            echo "       Set WORK_DIR explicitly or point HARNESS_CONFIG at a readable config.json." >&2
            return 1
        fi
        if [ -z "$EXEC_DIR" ]; then
            echo "Error: no harnessExecutionAndQueueDir in config '${CONFIG_FILE}' and WORK_DIR is not set." >&2
            return 1
        fi
        WORK_DIR="$EXEC_DIR"
    fi
    if [ ! -d "$WORK_DIR" ]; then
        echo "Error: WORK_DIR '${WORK_DIR}' does not exist." >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# cpuset fail-fast (spec §7): refuse a cpuset wider than the machine.
# ---------------------------------------------------------------------------
max_index_in_list() {
    local spec="$1" max=-1 part num
    local IFS=','
    for part in $spec; do
        num="${part##*-}"
        case "$num" in
            ''|*[!0-9]*) return 1 ;;
        esac
        if (( num > max )); then max=$num; fi
    done
    if (( max < 0 )); then return 1; fi
    echo "$max"
}

assert_cpuset_fits_host() {
    local requested_max host_max online_file
    online_file="${HARNESS_SYSFS_DIR:-/sys}/devices/system/cpu/online"
    if [ -r "$online_file" ]; then
        host_max="$(max_index_in_list "$(tr -d '[:space:]' < "$online_file")")" || return 0
    elif command -v nproc >/dev/null 2>&1; then
        host_max=$(( $(nproc) - 1 ))
    else
        return 0  # Cannot determine the host CPU count; skip the check.
    fi
    requested_max="$(max_index_in_list "$CPUSET")"
    if [ -z "$requested_max" ]; then
        echo "Error: HARNESS_CPUSET='${CPUSET}' is not a valid CPU list (e.g. 8-15 or 0,2-4)." >&2
        return 1
    fi
    if (( requested_max > host_max )); then
        echo "Error: --cpuset-cpus ${CPUSET} requests CPU ${requested_max}, but this host only has CPUs 0-${host_max}." >&2
        echo "       Set HARNESS_CPUSET to a range within 0-${host_max} (leave some cores for the LLM server)." >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Queue directory fail-fast (spec §9): launching against a missing queue dir
# would let the engine create it root-owned (or mount an empty one), so the
# runner refuses to launch — before dry-run print, before any engine call.
# ---------------------------------------------------------------------------
assert_queue_dir() {
    if [ ! -d "$QUEUE_DIR" ]; then
        echo "Error: queue directory '${QUEUE_DIR}' does not exist." >&2
        echo "       Create it, or set HARNESS_QUEUE_DIR / WORK_DIR to a tree that has one." >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Writable pi auth staging (FR-2.2): mirrors scripts/run-sandbox.sh — pi
# writes auth.json.lock next to auth.json, so the mount must be writable.
# ---------------------------------------------------------------------------
stage_pi_auth() {
    if [ ! -f "${PI_AGENT_DIR}/auth.json" ]; then
        return 0
    fi
    PI_AGENT_STAGE="$(mktemp -d /tmp/harness-pi-agent.XXXXXX)" || return 1
    cp -r "${PI_AGENT_DIR}/." "${PI_AGENT_STAGE}/" 2>/dev/null || true
}

cleanup_pi_auth_stage() {
    if [ -n "${PI_AGENT_STAGE:-}" ]; then
        rm -rf "$PI_AGENT_STAGE"
    fi
}

# ---------------------------------------------------------------------------
# Assemble the engine command (FR-2.2 through FR-2.4).
# ---------------------------------------------------------------------------
build_run_command() {
    local -n out_ref="$1"
    out_ref=(
        "$ENGINE_CMD" run --rm -i
        --memory "$MEM_LIMIT"
        --memory-swap "$MEM_SWAP_LIMIT"
        --cpuset-cpus "$CPUSET"
        --cpus "$CPU_QUOTA"
        --pids-limit "$PIDS_LIMIT"
        --oom-score-adj "$OOM_SCORE_ADJ"
        -w "$WORK_DIR"
        --tmpfs /tmp
    )
    # WORK_DIR at itself and at /workspace, then the config-declared dirs at
    # their declared paths (the queue dir rides along with, or is explicit).
    # WORK_DIR may itself be a symlinked config path, so bind the resolved dir.
    local work_src
    # `cd ... && pwd -P` rather than realpath: the tests put a stub engine dir
    # first on PATH, and a missing external must not blank the mount source.
    work_src="$(cd "$WORK_DIR" 2>/dev/null && pwd -P)" || work_src="$WORK_DIR"
    add_mount "$work_src" "$WORK_DIR"
    add_mount "$work_src" "/workspace"
    mount_declared "$EXEC_DIR" "harnessExecutionAndQueueDir"
    mount_declared "$TARGET_DIR" "targetCodebaseDir"
    local queue_src
    queue_src="$(cd "$QUEUE_DIR" 2>/dev/null && pwd -P)" || queue_src="$QUEUE_DIR"
    add_mount "$queue_src" "$QUEUE_DIR" force
    out_ref+=("${MOUNTS[@]}")
    if [ -n "$PI_AGENT_STAGE" ]; then
        # Writable on purpose — read-only breaks pi's auth.json.lock.
        out_ref+=(-v "${PI_AGENT_STAGE}:${PI_AGENT_MOUNT}${selinux_suffix}")
    fi
    out_ref+=("$IMAGE_TAG" python3 harness.py run --continue "${FORWARD_ARGS[@]}")
}

# ---------------------------------------------------------------------------
# Restart loop (FR-2.5): exit 0 ends the loop; 137 (OOM) and any other code
# resume from checkpoint after a short sleep.
# ---------------------------------------------------------------------------
run_restart_loop() {
    local -n run_cmd_ref="$1"
    local exit_code
    while true; do
        "${run_cmd_ref[@]}"
        exit_code=$?
        if [ "$exit_code" -eq 0 ]; then
            echo "==> Harness completed successfully (exit 0). Exiting loop."
            break
        elif [ "$exit_code" -eq 137 ]; then
            echo "==> Container terminated by OOM killer (exit 137). Resuming from checkpoint..."
            sleep "$RESTART_SLEEP"
        else
            echo "==> Harness crashed with code ${exit_code}. Checking retry threshold and resuming..."
            sleep "$RESTART_SLEEP"
        fi
    done
}

main() {
    FORWARD_ARGS=("$@")
    detect_engine || exit 1
    # SELinux relabel suffix; plain docker rejects the flag.
    selinux_suffix=""
    if [ "$ENGINE_CMD" = "podman" ]; then
        selinux_suffix=":z"
    fi
    resolve_work_dir || exit 1
    QUEUE_DIR="${HARNESS_QUEUE_DIR:-${EXEC_DIR:-$WORK_DIR}/queue}"
    assert_queue_dir || exit 1
    assert_cpuset_fits_host || exit 1
    stage_pi_auth || exit 1
    trap cleanup_pi_auth_stage EXIT

    local run_cmd
    build_run_command run_cmd

    if [ "${HARNESS_DRY_RUN:-}" = "1" ]; then
        echo "${run_cmd[*]}"
        exit 0
    fi
    run_restart_loop run_cmd
}

main "$@"
